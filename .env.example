# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=regdocs

# Embedding — OpenRouter (nemotron-3-embed-1b gratis, 2048 dim, prefix query:/document:)
OPENROUTER_API_KEY=
EMBED_MODEL=nvidia/nemotron-3-embed-1b:free

# LLM — Google Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Pagar aplikasi (Tahap 11). Budget dihitung per proses dan ikut nol
# saat container dibuat ulang.
BUDGET_LLM_HARIAN=200
RATE_LIMIT_QUERY=10/minute

# Pemantauan (Tahap 12). Opsional — tanpa kedua key ini, trace tetap
# muncul di respons API, hanya tidak dikirim ke mana-mana.
# Daftar gratis di https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
